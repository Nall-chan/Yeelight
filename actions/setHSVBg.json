{
    "id": "{CC557A7F-C793-4850-973A-E42DBE188B4D}",
    "caption": "Set or fade to background color (HSV)",
    "form": [
        {
            "caption": "Hue",
            "name": "HUE",
            "type": "NumberSpinner",
            "minimum": 0,
            "maximum": 359,
            "suffix": " °"
        },
        {
            "caption": "Saturation",
            "name": "SATURATION",
            "type": "HorizontalSlider",
            "minimum": 0,
            "maximum": 100
        },
        {
            "caption": "Fading duration",
            "name": "DURATION",
            "type": "NumberSpinner",
            "digits": 2,
            "minimum": 0,
            "maximum": 900,
            "suffix": " seconds"
        }
    ],
    "action": [
        "if ($_IPS['DURATION'] < 0.03){",
        "    YEELIGHT_SetBgHSV($_IPS['TARGET'], $_IPS['HUE'], $_IPS['SATURATION']);",
        "} else {",
        "    YEELIGHT_SetBgHSVSmooth($_IPS['TARGET'], $_IPS['HUE'], $_IPS['SATURATION'], (int) ($_IPS['DURATION'] * 1000));",
        "}"
    ],
    "readable": [
        "if ($_IPS['DURATION'] < 0.03){",
        "   printf('YEELIGHT_SetBgHSV(%d, %d, %d);', $_IPS['TARGET'], $_IPS['HUE'], $_IPS['SATURATION']);",
        "} else {",
        "   printf('YEELIGHT_SetBgHSVSmooth(%d, %d, %d, %d);', $_IPS['TARGET'], $_IPS['HUE'], $_IPS['SATURATION'], (int) ($_IPS['DURATION'] * 1000));",
        "}"
    ],
    "category": "target",
    "restrictions": {
